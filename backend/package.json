{
  "name": "safe-solutions-backend",
  "version": "1.0.0",
  "description": "SAFE SOLUTIONS Fleet Management and Smart Attendance System REST API Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "node ./node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "prisma:push": "node ./node_modules/prisma/build/index.js db push",
    "prisma:seed": "node ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "prisma:verify": "node ./node_modules/tsx/dist/cli.mjs prisma/verify-seed.ts",
    "test": "node ./node_modules/tsx/dist/cli.mjs tests/run-all-tests.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "tesseract.js": "^5.1.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.5",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
